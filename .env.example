# Copy to .env.local (local dev) and add the same keys in Vercel → Settings → Environment Variables.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Safepay (online card / wallet payments) ---
# Leave SAFEPAY_API_KEY empty or "mock" in local dev to use the mock checkout page.
# Mock checkout is always disabled in production.
SAFEPAY_API_KEY=
SAFEPAY_SECRET=
SAFEPAY_WEBHOOK_SECRET=
# "sandbox" (default) for test keys, "production" for live keys
SAFEPAY_ENVIRONMENT=sandbox
# Webhook URL to set in the Safepay dashboard: https://your-domain.com/api/payments/webhook

# --- Supabase keep-alive cron ---
# Any long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=your-random-secret

# --- Upstash Redis (cache + rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Admin login ---
ADMIN_FAVORITE_FOOD=
ADMIN_SECRET_KEY=

# --- Lectures ---
COMPLETION_THRESHOLD=90
